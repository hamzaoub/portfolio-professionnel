{
  "name": "portfolio-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src vite.config.ts",
    "format": "prettier --write . ../shared/contracts.ts",
    "format:check": "prettier --check . ../shared/contracts.ts",
    "preview": "vite preview",
    "test": "vitest run"
